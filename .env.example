# Copy to .env and fill in. NEVER commit .env.

# Anthropic (Claude auto-interp labels + honesty-judge adjudication)
ANTHROPIC_API_KEY=

# Sentry (Best Use of Sentry API) — DSN from your Sentry project
SENTRY_DSN=

# Arize Phoenix (local, default OK)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# HuggingFace (gemma-2-2b-it is gated; or set MODEL_ID=unsloth/gemma-2-2b-it to skip)
HF_TOKEN=

# Runtime
GLASSBOX_MODE=posthoc          # posthoc | live
CUDA_VISIBLE_DEVICES=0

# GPU pod (optional — local backend proxies /turn and /api/track here)
POD_URL=http://127.0.0.1:8001
POD_TOKEN=glassbox-dev-secret  # dev default only; set a strong token in production

# Sentry REST API (optional — populates alarm issues on the Observe tab)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
